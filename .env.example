# ── Google Gemini API Key ─────────────────────────────────────────────
# 발급: https://aistudio.google.com/apikey
# 신규 키 형식은 "AQ.Ab8..." 또는 "AIza..." 두 가지가 있으며 둘 다 지원됩니다.
#
# 실제 키는 이 파일이 아니라 .env.local 에 저장하세요 (.gitignore 처리됨):
#   cp .env.example .env.local  &&  .env.local 의 값을 실제 키로 교체
#
# 키를 설정하지 않으면 /api/explain 는 로컬 사전(lib/mock-terms.ts)으로 자동 폴백합니다.
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) 모델 우선순위를 쉼표로 오버라이드. 미설정 시 코드 기본값 사용.
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.6-flash,gemini-flash-latest
